set hidden true
set preview true
set icons true
set drawbox true
set previewer ~/.config/lf/preview.sh
set info size
set number true
set relativenumber true
set ratios 1:3:4
set ignorecase true
set ifs "\n"
set filesep "\n"

# Sort by modification time (newest first)
set sortby time
set reverse true

# --- Theme -----------------------------------------------------------------
# Tokyo Night, matching common/.config/yazi/theme.toml. Palette reference:
# docs/tokyonight.md.
#
# `colors` beside this file only covers *file names*; everything below is lf's
# chrome, and all of it was on lf's built-in defaults — plain 16-colour ANSI,
# and in three places the opposite of the decisions already made for yazi:
#
#   - the cursor was a reverse-video flip, which is what yazi's theme
#     deliberately replaced with a fill so the icon and git colours survive
#     underneath it
#   - the preview cursor was an underline, "a hard rule across an unfocused
#     pane" in that file's words
#   - copy was yellow and select was magenta, while yazi marks copied files
#     green and selected files yellow — so the same two keys meant different
#     colours in the two file managers
#
# Written as raw SGR because that is lf's format: 38;2;R;G;B is a foreground,
# 48;2;R;G;B a background, and a leading 7 swaps them the way lf's own
# defaults do.

# Boxes (drawbox is on above), in the same border colour as yazi's panes.
set borderfmt "\033[38;2;41;46;66m"

# The hovered row, in the three panes. Focused gets bg_visual, the fill that
# marks the current row in fzf, yazi, lazygit, btop and tmux's copy mode; the
# other two get the quieter fill, because nothing there has your attention.
set cursoractivefmt "\033[48;2;40;52;87;38;2;192;202;245m"
set cursorparentfmt "\033[48;2;41;46;66m"
set cursorpreviewfmt "\033[48;2;41;46;66m"

# Yank, cut and select markers, matching yazi's marker_* colours exactly.
set copyfmt "\033[7;38;2;158;206;106m"
set cutfmt "\033[7;38;2;247;118;142m"
set selectfmt "\033[7;38;2;224;175;104m"

# Line numbers in dark3 — the palette's own colour for them, and the one
# delta uses in a diff.
set numberfmt "\033[38;2;84;92;126m"

# Errors were reverse red on white, the only white in the whole theme.
set errorfmt "\033[7;38;2;219;75;75m"

# The stat line's permission string, in the blue yazi gives permission type.
set statfmt "\033[38;2;122;162;247m%p\033[0m| %c| %u| %g| %S| %t| -> %l"

# "you", in the teal starship gives your username and eza gives your own files;
# the directory in the blue every directory has here; the file name plain.
set promptfmt "\033[38;2;26;188;156m%u@%h\033[0m:\033[1;38;2;122;162;247m%d\033[0m\033[1m%f\033[0m"

map <esc> quit
map x cut
map y copy
map p paste
map d delete
map D delete!
map O push :mkdir<space>
map o push :touch<space>
map i rename
map c rename
map v toggle
map V toggle
map a unselect
map f search
# Pager for viewing files with syntax highlighting
map s $bat --paging=always --style=numbers,changes --color=always --decorations=always "$f"
# map e nvim -- $fx
map go cd ~/Documents
map gd cd ~/Downloads
map gp cd ~/Projects
map ge cd ~/Desktop
map gv cd ~/.config/Code/User
map gn cd ~/.config/nvim
map gs cd ~/dotfiles

# Context-aware file opening (no custom env; detect VS Code via TERM_PROGRAM/VSCODE_* vars)
cmd open ${{
	# If running inside VS Code integrated terminal, open in VS Code
	if [ "$TERM_PROGRAM" = "vscode" ] || [ -n "$VSCODE_PID" ] || [ -n "$VSCODE_GIT_IPC_HANDLE" ]; then
		code -r -- $fx
	else
		# Default: open in neovim and quit lf
		lf -remote "send $id quit"
		nvim -- $fx
	fi
}}

# Open files with macOS default application (e.g., PDFs in Preview)
cmd open-default ${{
	open -- $fx
}}

# Map shift+enter to open with default macOS application
map E open-default

