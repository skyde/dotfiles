# vim:ft=conf
#
# Tokyo Night (night) for lf.
# Palette reference: docs/tokyonight.md
#
# Format is LS_COLORS, one "pattern  ansi" pair per line. Truecolor is written
# as 38;2;R;G;B (foreground) and 48;2;R;G;B (background); lf falls back to the
# terminal's ANSI palette when truecolor is unavailable, and those 16 colours
# are already Tokyo Night via kitty/wezterm, so it degrades cleanly.

# --- file type defaults ---
ln      38;2;125;207;255           # symlink            → cyan   #7dcfff
or      38;2;247;118;142;1         # broken symlink     → red    #f7768e bold
mh      38;2;125;207;255           # multi-hardlink     → cyan
di      38;2;122;162;247;1         # directory          → blue   #7aa2f7 bold
ex      38;2;158;206;106           # executable         → green  #9ece6a
fi      38;2;192;202;245           # regular file       → fg     #c0caf5
pi      38;2;224;175;104           # named pipe         → yellow #e0af68
so      38;2;187;154;247           # socket             → magenta #bb9af7
bd      38;2;224;175;104;48;2;41;46;66   # block device
cd      38;2;224;175;104;48;2;41;46;66   # char device
su      38;2;22;22;30;48;2;247;118;142   # setuid
sg      38;2;22;22;30;48;2;224;175;104   # setgid
tw      38;2;22;22;30;48;2;158;206;106   # sticky + other-writable
ow      38;2;122;162;247;48;2;40;52;87   # other-writable
st      38;2;192;202;245;48;2;122;162;247 # sticky

