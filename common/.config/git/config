# --- Git paging through delta ---
[pager]
    diff = delta
    show = delta
    log  = delta

[interactive]
    diffFilter = delta --color-only

[core]
    pager = delta
    excludesFile = ~/.config/git/ignore
    commitGraph = true
    autocrlf = false
    filemode = false

[init]
    defaultBranch = main
    defaultRefFormat = files

# --- Diff behavior ---
[diff]
    context = 10
    # Paint relocated code as "moved" instead of add/remove green/red, so the
    # eye stays on the real changes. Git marks the moved lines with its own
    # colours; delta recognises those and restyles them via map-styles below.
    # Note git only calls a block moved from ~20 alphanumeric chars up — a
    # shuffled one-liner still shows as plain add/remove, by design.
    colorMoved = default
    colorMovedWS = allow-indentation-change
    algorithm = histogram
    # Neovim is the default now; `git difftool -g` still reaches VS Code.
    tool = nvim
    guitool = vscode

# Stop git appending "function context" (the nearest enclosing-function line)
# after every @@ hunk header. Delta prints that context in its hunk header no
# matter what hunk-header-style says, so a clean "file:line" header needs git
# to not emit context at all: a driver whose xfuncname never finds a function,
# assigned to every path by the attributes file beside this config. Costs:
# `git log -L :name:file` and `git diff -W` stop finding functions. A repo's
# own .gitattributes still overrides this.
[diff "nofunc"]
    xfuncname = "^$"

[difftool]
    prompt = false

[difftool "vscode"]
    cmd = code --wait --diff $LOCAL $REMOTE
    trustExitCode = true

[difftool "nvim"]
    cmd = nvim -f -d "$LOCAL" "$REMOTE"

[difftool "nvimdiff"]
    cmd = nvim -f -d "$LOCAL" "$REMOTE"

[rerere]
    enabled = true                  # remember how you resolved a conflict
    autoupdate = true               # auto-apply remembered fixes into the index

[rebase]
    autoSquash = true               # honor "fixup!" / "squash!" automatically
    autoStash  = true               # stash dirty changes before rebase, reapply after
    # optional: make preserving merges the default
    rebaseMerges = no-rebase-cousins
    # optional: update stacked branches automatically when you rebase
    updateRefs = true

[merge]
    conflictstyle = zdiff3
    tool = nvim
    guitool = vscode

[mergetool]
    prompt = false
    # $MERGED already carries the conflict markers, so there is nothing to
    # clean up and no *.orig litter to leave behind.
    keepBackup = false

[mergetool "vscode"]
    cmd = code --wait --merge $LOCAL $REMOTE $BASE $MERGED
    trustExitCode = true

# Opens the conflicted file itself rather than a three-pane split. The conflict
# keys in lua/config/vcs.lua (<leader>co/ct/cb, ]x/[x, <leader>cm for the
# three-way view) all work off the markers, so this is the richer starting
# point — and <leader>cq refuses to close while markers remain.
[mergetool "nvim"]
    cmd = nvim -f "$MERGED"
    trustExitCode = false

[mergetool "nvimdiff3"]
    cmd = nvim -f -d "$LOCAL" "$MERGED" "$REMOTE"
    trustExitCode = false

# --- Delta styling ---
# Everything lives in this one [delta] section on purpose. Named [delta "..."]
# features are only half-wired on delta 0.18.2, which is worse than being
# broken outright — probing one feature key at a time shows plain options like
# hunk-header-style and tabs *do* come through --features / DELTA_FEATURES,
# every *-style key silently does not, and side-by-side reports as set under
# `--show-config` while the output stays unified. A feature section therefore
# applies some of what you wrote and drops the rest with no error. Don't use
# them: for an occasional toggle use a `git -c delta.<option>=<value>` alias,
# which git exports to the pager through GIT_CONFIG_PARAMETERS and delta reads
# like any other git config. See the `sbs` alias at the bottom.
#
# Keys are validated against the installed delta by tests/check-delta-config.sh
# — delta ignores unknown keys in git config without a word, so a typo or an
# option from a newer release reads as live config and does nothing.
# Palette reference: docs/tokyonight.md
[delta]
    # Syntax highlighting stays Visual Studio Dark+ on purpose, matching bat and
    # VS Code. Tokyo Night is the chrome around the code, not the code itself.
    syntax-theme = "Visual Studio Dark+"

    # Be explicit for TUIs like LazyGit
    dark = true                 # better than 'light = false' under TUIs
    true-color = always
    navigate = true             # n / N to jump between files (regex below)
    side-by-side = false
    line-numbers = true

    # Tabs render at the width VS Code shows them at ("editor.tabSize": 2 with
    # detectIndentation off, in Code/User/settings.json in this repo), so a
    # tab-indented file is indented the same depth in the diff as in the editor
    # you are about to open it in. Delta's default of 8 also costs real width:
    # it does not wrap in unified mode — long lines run off the panel rather
    # than continuing — so every column spent on indentation is a column of
    # code lost, and lazygit's diff panel is half a screen wide.
    tabs = 2

    # How many lines delta holds while pairing removals with additions to find
    # the changed tokens within a line. The default 32 is far too small here,
    # because diff.context = 10 above makes hunks correspondingly bigger: on a
    # block replacement (rename a variable through a function, reflow a table)
    # measured emphasis coverage was 27/60 lines at 32, 3/300 at 32 for a
    # larger block, and complete at 512 for anything up to ~256 lines. The
    # buffer has to hold the whole run of removals plus the run of additions,
    # so it wants roughly twice the block size. Delta's docs warn this hurts
    # performance on whole-file adds; on 12k- and 20k-line diffs the cost from
    # 32 to 16384 was under the run-to-run noise, so 512 is free.
    line-buffer-size = 512

    # Delta's own annotations — the ↵ that marks a wrapped line in side-by-side,
    # the tab markers — default to bare ANSI blue, the one colour in the output
    # that is not from the palette. It has to stay legible on the minus and
    # plus backgrounds, which rules out the comment grey.
    inline-hint-style = "#7aa2f7"

    # File headers. These were omitted for a while, on the reasoning that every
    # hunk header already carries file:line. That reasoning only holds for
    # files that *have* a hunk — and the ones that don't are exactly the ones
    # worth seeing. With file-style = omit, `git diff` renders a changed binary
    # file and a chmod as one blank line and nothing else: no filename, no
    # marker, nothing. A blob swap and a script quietly becoming executable
    # were both invisible in the terminal and in lazygit's diff panel, which
    # runs this same config. Pure renames vanished the same way. That is a
    # correctness hole in review, not a matter of taste, so the header is back
    # at its cheapest: no decoration, one row plus the blank row that
    # file-style = omit was paying for anyway.
    #
    # The labels are git's own status letters, matching `git status --short`
    # and the changed-files panel in lua/util/vcs_ui.lua, so the terminal and
    # the editor name a change the same way. For the files that carry no hunk
    # delta adds its own note: "M blob.bin (binary file)", "M run.sh (mode +x)".
    # (C is git's "copied", not vcs_ui's "conflict" — copy detection is off by
    # default, so it is near enough unreachable.)
    file-style = "bold #7aa2f7"
    file-decoration-style = omit
    file-added-label = "A"
    file-removed-label = "D"
    file-modified-label = "M"
    file-renamed-label = "R"
    file-copied-label = "C"
    # Joins the two sides of a rename ("R old ⟶ new") and the two sides of a
    # merge-conflict header. Delta's default is "⟶  " — the trailing spaces
    # land on top of the space delta already inserts, giving "old ⟶   new".
    # Deliberately not "→": that is delta's own line-truncation marker.
    right-arrow = "⟶"
    # n / N step file to file, and commit to commit under `git log -p`. Hunks
    # are a scroll away; files are what you actually want to skip to. Content
    # lines can never collide with this: they all start with the line-number
    # gutter, so column 0 is a digit or a space, never a status letter.
    navigate-regex = "^([ADMRC] |commit )"

    # Hunk headers. No decoration: with file+line-number in the header text
    # itself, the single coloured line after a blank row separates fine, and
    # the old box+ul spent three extra rows on every hunk.
    #
    # The filename stays here even though the file header above now repeats it.
    # The duplication costs one row, and only at the first hunk of a file; drop
    # it and *every* hunk after the first stops saying where it is, which is
    # precisely when you need telling — mid-file, several screens down. It also
    # keeps the header in the file:line: shape that compilers and rg emit, so
    # it can be copied straight into an editor. Since it is a locator rather
    # than a headline it is painted in the comment grey, one step under the
    # file header, with the line number — the part that actually changes — in
    # the accent blue.
    #
    # The function context — code from lines *above* the hunk that read as a
    # line of code wearing the wrong line number — is stripped at the source
    # by the [diff "nofunc"] driver above; delta prints whatever context git
    # emits regardless of which style attributes are listed here (dropping
    # `syntax` only stops highlighting it). What is left is a trailing ": ",
    # the separator for a context string that never arrives. There is no
    # option to suppress it, and file:line: is the idiomatic shape anyway.
    hunk-header-style = file line-number
    hunk-label = "•"
    hunk-header-file-style = "#565f89"
    hunk-header-line-number-style = "#7aa2f7"
    hunk-header-decoration-style = omit

    # Commit meta (same reasoning as the file header)
    commit-style = "bold #c0caf5"
    commit-decoration-style = "#292e42 ul"

    # Diff body.
    # These nine colours are mirrored, hex for hex, by the highlight groups in
    # lua/util/inline_diff.lua so the Neovim inline diff and a terminal patch
    # are the same picture. Change one here and change it there — the pairing
    # is asserted by tests/check-delta-config.sh.
    plus-style = "syntax #20432b"
    plus-emph-style = "syntax #2c5a3a"
    plus-non-emph-style = "syntax #17311f"
    minus-style = "syntax #532727"
    minus-emph-style = "syntax #683131"
    minus-non-emph-style = "syntax #3f1f1f"
    zero-style = syntax
    whitespace-error-style = "#db4b4b reverse"

    # Moved code (diff.colorMoved above). Git paints moved-out lines bold
    # magenta/blue and moved-in lines bold cyan/yellow; remap those onto quiet
    # Tokyo Night-tinted backgrounds — violet/indigo for "left from here",
    # cyan/teal for "landed here" — keeping the syntax-highlighted foreground.
    # Moves then sit visually between unchanged code and real add/remove.
    map-styles = "bold purple => syntax #2e2547, bold blue => syntax #203356, bold cyan => syntax #12384a, bold yellow => syntax #15423d"

    # Line numbers
    line-numbers-left-style = "#545c7e"
    line-numbers-right-style = "#545c7e"
    line-numbers-zero-style = "#545c7e"
    line-numbers-plus-style = "#9ece6a dim"   # additions → Tokyo Night green, dimmed
    line-numbers-minus-style = "#f7768e dim"  # deletions → Tokyo Night red, dimmed
    line-numbers-left-format = ""
    line-numbers-right-format = "{np:<4}"

    # Blame (delta paints `git blame` too): cycle four near-background shades so
    # adjacent commits separate without the stripes shouting.
    # There is no blame-timestamp-style on 0.18.2 — only -format and
    # -output-format — so the metadata column takes the default foreground.
    # A key by that name lived here for a while doing nothing at all, which is
    # what tests/check-delta-config.sh now exists to catch.
    # Blame lines are only recognised at all when the author name is two
    # characters or more; a one-letter name falls through delta's parser and
    # prints raw.
    blame-code-style = syntax
    blame-palette = "#1a1b26 #1f2335 #24283b #292e42"
    blame-separator-style = "#3b4261"

    # Merge conflicts (merge.conflictstyle = zdiff3 above shows all three sides).
    # The ▼/▲ bars are drawn the full width of the terminal and are the outer
    # boundary, so the two inner headers need no decoration of their own — the
    # box they used to carry spent four rows inside the one region where you
    # are trying to read code closely. Ours and theirs were also both yellow,
    # which left the side label as the only thing telling them apart; they now
    # take the accent blue and the branch magenta, the same split the conflict
    # highlighting in lua/util/conflict.lua draws in the editor.
    merge-conflict-begin-symbol = "▼"
    merge-conflict-end-symbol = "▲"
    merge-conflict-ours-diff-header-style = "#7aa2f7 bold"
    merge-conflict-ours-diff-header-decoration-style = omit
    merge-conflict-theirs-diff-header-style = "#bb9af7 bold"
    merge-conflict-theirs-diff-header-decoration-style = omit

    # `delta --grep` / rg integration. Matches are inverted yellow blocks for
    # the same reason as fzf's hl/hl+ (see theme.sh): a recoloured foreground
    # drowns in already-syntax-coloured lines; reverse video cannot.
    grep-file-style = "#7aa2f7"
    grep-line-number-style = "#545c7e"
    grep-match-line-style = syntax
    grep-match-word-style = "#e0af68 bold reverse"

[index]
    threads = 10

[pack]
    threads = 0

[gc]
    writeCommitGraph = true

[fetch]
    writeCommitGraph = true

[feature]
    manyFiles = true

[maintenance]
    strategy = incremental

[protocol "sso"]
    allow = always

[branch]
    autosetuprebase = always

[include]
    path = ~/.gitconfig-local

[alias]
	dft = -c diff.external=difft diff
	# Occasional side-by-side diff. A [delta "side-by-side"] feature cannot do
	# this on delta 0.18 (see the note above the [delta] section); `git -c` can,
	# because git hands the setting to the pager via GIT_CONFIG_PARAMETERS. The
	# left line-number column comes back for the occasion: the left panel is the
	# old file, and the global "" format would leave it unnumbered.
	sbs = -c delta.side-by-side=true -c "delta.line-numbers-left-format={nm:>4} " diff
