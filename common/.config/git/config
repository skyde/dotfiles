# --- Git paging through delta ---
[pager]
    diff = delta
    show = delta
    log  = delta

[interactive]
    diffFilter = delta --color-only

[core]
    pager = delta
    excludesFile = ~/.config/git/ignore
    commitGraph = true
    autocrlf = false
    filemode = false

[init]
    defaultBranch = main
    defaultRefFormat = files

# --- Diff behavior ---
[diff]
    context = 10
    # Paint relocated code as "moved" instead of add/remove green/red, so the
    # eye stays on the real changes. Git marks the moved lines with its own
    # colours; delta recognises those and restyles them via map-styles below.
    # Note git only calls a block moved from ~20 alphanumeric chars up — a
    # shuffled one-liner still shows as plain add/remove, by design.
    colorMoved = default
    colorMovedWS = allow-indentation-change
    algorithm = histogram
    # Neovim is the default now; `git difftool -g` still reaches VS Code.
    tool = nvim
    guitool = vscode

# Stop git appending "function context" (the nearest enclosing-function line)
# after every @@ hunk header. Delta prints that context in its hunk header no
# matter what hunk-header-style says, so a clean "file:line" header needs git
# to not emit context at all: a driver whose xfuncname never finds a function,
# assigned to every path by the attributes file beside this config. Costs:
# `git log -L :name:file` and `git diff -W` stop finding functions. A repo's
# own .gitattributes still overrides this.
[diff "nofunc"]
    xfuncname = "^$"

[difftool]
    prompt = false

[difftool "vscode"]
    cmd = code --wait --diff $LOCAL $REMOTE
    trustExitCode = true

[difftool "nvim"]
    cmd = nvim -f -d "$LOCAL" "$REMOTE"

[difftool "nvimdiff"]
    cmd = nvim -f -d "$LOCAL" "$REMOTE"

[rerere]
    enabled = true                  # remember how you resolved a conflict
    autoupdate = true               # auto-apply remembered fixes into the index

[rebase]
    autoSquash = true               # honor "fixup!" / "squash!" automatically
    autoStash  = true               # stash dirty changes before rebase, reapply after
    # optional: make preserving merges the default
    rebaseMerges = no-rebase-cousins
    # optional: update stacked branches automatically when you rebase
    updateRefs = true

[merge]
    conflictstyle = zdiff3
    tool = nvim
    guitool = vscode

[mergetool]
    prompt = false
    # $MERGED already carries the conflict markers, so there is nothing to
    # clean up and no *.orig litter to leave behind.
    keepBackup = false

[mergetool "vscode"]
    cmd = code --wait --merge $LOCAL $REMOTE $BASE $MERGED
    trustExitCode = true

# Opens the conflicted file itself rather than a three-pane split. The conflict
# keys in lua/config/vcs.lua (<leader>co/ct/cb, ]x/[x, <leader>cm for the
# three-way view) all work off the markers, so this is the richer starting
# point — and <leader>cq refuses to close while markers remain.
[mergetool "nvim"]
    cmd = nvim -f "$MERGED"
    trustExitCode = false

[mergetool "nvimdiff3"]
    cmd = nvim -f -d "$LOCAL" "$MERGED" "$REMOTE"
    trustExitCode = false

# --- Delta styling ---
# Everything lives in this one [delta] section on purpose. On delta 0.18 named
# [delta "..."] features are effectively dead: beyond the long-known dropping
# of commit-style / file-style / *-decoration-style, neither DELTA_FEATURES nor
# --features applies a feature section from git config at all (verified with a
# probe feature that changed nothing). For an occasional toggle use a `git -c
# delta.<option>=<value>` alias instead — git exports -c to the pager through
# GIT_CONFIG_PARAMETERS, which delta reads like any other git config. See the
# `sbs` alias at the bottom for the side-by-side example.
# Palette reference: docs/tokyonight.md
[delta]
    # Syntax highlighting stays Visual Studio Dark+ on purpose, matching bat and
    # VS Code. Tokyo Night is the chrome around the code, not the code itself.
    syntax-theme = "Visual Studio Dark+"

    # Be explicit for TUIs like LazyGit
    dark = true                 # better than 'light = false' under TUIs
    true-color = always
    navigate = true             # n / N to jump between hunks (regex below)
    side-by-side = false
    line-numbers = true


    # File headers are omitted entirely: every hunk header carries file:line,
    # so a standalone header row — plus its decoration, labels and the blank
    # rows around it — bought four rows of height per file and repeated what
    # the hunk headers already say; in lazygit the panel names the file on top
    # of that. Two costs, both accepted: a pure rename with no content change
    # renders no diff at all (git status and lazygit's files panel still show
    # it), and n/N loses its file-header anchor, so navigate-regex points it
    # at hunk headers instead.
    file-style = omit
    navigate-regex = "^• "

    # Hunk headers. No decoration at all: with file+line-number in the header
    # text itself, the blue single line after a blank row separates fine, and
    # the old box+ul spent three extra rows on every hunk.
    # The function context — code from lines *above* the hunk that read as a
    # line of code wearing the wrong line number — is stripped at the source
    # by the [diff "nofunc"] driver above; delta prints whatever context git
    # emits regardless of which style attributes are listed here (dropping
    # `syntax` only stops highlighting it).
    hunk-header-style = file line-number
    hunk-header-file-style = "#7aa2f7"
    hunk-header-line-number-style = "bold #7aa2f7"
    hunk-header-decoration-style = omit

    # Commit meta (same reasoning as the file header)
    commit-style = "bold #c0caf5"
    commit-decoration-style = "#292e42 ul"

    # Diff body
    plus-style = "syntax #20432b"
    plus-emph-style = "syntax #2c5a3a"
    plus-non-emph-style = "syntax #17311f"
    minus-style = "syntax #532727"
    minus-emph-style = "syntax #683131"
    minus-non-emph-style = "syntax #3f1f1f"
    zero-style = syntax
    whitespace-error-style = "#db4b4b reverse"

    # Moved code (diff.colorMoved above). Git paints moved-out lines bold
    # magenta/blue and moved-in lines bold cyan/yellow; remap those onto quiet
    # Tokyo Night-tinted backgrounds — violet/indigo for "left from here",
    # cyan/teal for "landed here" — keeping the syntax-highlighted foreground.
    # Moves then sit visually between unchanged code and real add/remove.
    map-styles = "bold purple => syntax #2e2547, bold blue => syntax #203356, bold cyan => syntax #12384a, bold yellow => syntax #15423d"

    # Line numbers
    line-numbers-left-style = "#545c7e"
    line-numbers-right-style = "#545c7e"
    line-numbers-zero-style = "#545c7e"
    line-numbers-plus-style = "#9ece6a dim"   # additions → Tokyo Night green, dimmed
    line-numbers-minus-style = "#f7768e dim"  # deletions → Tokyo Night red, dimmed
    line-numbers-left-format = ""
    line-numbers-right-format = "{np:<4}"

    # Blame (delta paints `git blame` too): cycle four near-background shades so
    # adjacent commits separate without the stripes shouting.
    blame-code-style = syntax
    blame-palette = "#1a1b26 #1f2335 #24283b #292e42"
    blame-separator-style = "#3b4261"
    # There is no blame-timestamp-style, and there never was — delta has
    # blame-timestamp-format and blame-timestamp-output-format, but no style
    # option for that field. One was set here and, like any unknown key in a
    # git config, was read by nobody. The blame prefix has exactly two knobs
    # that take a colour: blame-palette for the per-commit background, and
    # blame-separator-style; the author and timestamp take the foreground
    # they are given.

    # Merge conflicts (merge.conflictstyle = zdiff3 above shows all three sides)
    merge-conflict-begin-symbol = "▼"
    merge-conflict-end-symbol = "▲"
    merge-conflict-ours-diff-header-style = "#e0af68 bold"
    merge-conflict-ours-diff-header-decoration-style = "#292e42 box"
    merge-conflict-theirs-diff-header-style = "#e0af68 bold"
    merge-conflict-theirs-diff-header-decoration-style = "#292e42 box"

    # Delta's own annotations — the marker on a wrapped line, the characters
    # standing in for tabs, the "+N" on a collapsed one. They are notes about
    # the diff rather than part of it, so not delta's default blue: that is the
    # primary accent, worn by hunk headers and grep file paths, and it reads as
    # though the mark belonged to the code.
    #
    # The tertiary grey rather than the darker `comment` grey, because unlike a
    # comment these are painted on the diff backgrounds, not on the page.
    # #565f89 measures 2.76:1 against #1a1b26 and then falls to 1.29:1 on the
    # emphasised plus background, which is not a mark you can find. #737aa2
    # holds 1.91:1 there and 2.98:1 on a removed line.
    inline-hint-style = "#737aa2"

    # `delta --grep` / rg integration. Matches are inverted yellow blocks for
    # the same reason as fzf's hl/hl+ (see theme.sh): a recoloured foreground
    # drowns in already-syntax-coloured lines; reverse video cannot.
    grep-file-style = "#7aa2f7"
    grep-line-number-style = "#545c7e"
    grep-match-line-style = syntax
    grep-match-word-style = "#e0af68 bold reverse"
    # `rg --heading`-shaped output puts the file on its own row instead of at
    # the start of every line. Same blue, and no decoration, for the same
    # reason the hunk header has none.
    grep-header-file-style = "#7aa2f7 bold"
    grep-header-decoration-style = omit
    grep-context-line-style = syntax

# --- Git's own colours ---
# Delta paints diffs. Everything else git prints — status, branch listings,
# the decorations in a log graph — it colours itself, and it was doing that
# from its defaults: plain ANSI names that land on this palette by way of the
# terminal, but with git's meanings rather than these ones. Most visibly,
# default `git status` paints a modified file and an untracked file the same
# red, when only one of those is anything like an error.
#
# The colours below are the roles docs/tokyonight.md already assigns: green
# added, yellow modified, teal untracked or new, magenta a branch, cyan a
# remote, and orange for HEAD — the "you are here" colour that the cursor and
# the current search match already wear.
#
# There is deliberately no [color "diff"] section. Delta's map-styles matches
# on the exact colours git emits for moved code — `bold purple`, `bold cyan`
# and friends — so overriding git's diff colours would quietly stop moves from
# being recognised, and the diff would go back to reading as plain add/remove.
# `color.grep` is absent for the same reason: `delta --grep` does its own match
# styling, in the grep-*-style options above.
#
# Every color.* section git reads lives in this one run, and each appears once.
# git merges repeated sections and lets the last value win, so a second
# [color "status"] further up the file is not a conflict it reports — it is a
# block that silently does nothing. This file had exactly that, three sections
# deep, painting remote refs purple here and cyan there; tests/check-theme.py
# now fails on a repeated key.
[color "status"]
    header = "#565f89"
    added = "#9ece6a"
    changed = "#e0af68"
    untracked = "#1abc9c"
    unmerged = "#f7768e bold"
    branch = "#bb9af7 bold"
    nobranch = "#f7768e bold"
    localBranch = "#bb9af7"
    remoteBranch = "#7dcfff"
    # `updated` is staged-and-modified, which git prints in the same list as
    # `added`; same green, since the distinction it draws is not one of state.
    updated = "#9ece6a"

[color "branch"]
    current = "#bb9af7 bold"
    local = "#a9b1d6"
    remote = "#7dcfff"
    # Not a remote-tracking ref, so not the remote cyan: `upstream` is the
    # branch a local branch follows, and it appears beside `remote` in
    # `branch -vv` where the two need telling apart.
    upstream = "#9d7cd8"
    # `plain` is every other branch in the list. Left at the body foreground
    # rather than unset, so the listing does not inherit whatever the
    # terminal's default happens to be.
    plain = "#c0caf5"

[color "decorate"]
    HEAD = "#ff9e64 bold"
    branch = "#bb9af7 bold"
    remoteBranch = "#7dcfff"
    tag = "#e0af68"
    stash = "#9d7cd8"
    grafted = "#f7768e"

# `add -p`, `checkout -p` and the rest of git's interactive prompts.
[color "interactive"]
    prompt = "#7aa2f7"
    header = "#c0caf5 bold"
    help = "#565f89"
    error = "#f7768e bold"

# What `push` and `fetch` print back from the far end, including the hints a
# server sends for a rejected push.
[color "remote"]
    hint = "#565f89"
    warning = "#e0af68"
    success = "#9ece6a"
    error = "#f7768e bold"

[index]
    threads = 10

[pack]
    threads = 0

[gc]
    writeCommitGraph = true

[fetch]
    writeCommitGraph = true

[feature]
    manyFiles = true

[maintenance]
    strategy = incremental

[protocol "sso"]
    allow = always

[branch]
    autosetuprebase = always

[include]
    path = ~/.gitconfig-local

[alias]
	dft = -c diff.external=difft diff
	# Occasional side-by-side diff. A [delta "side-by-side"] feature cannot do
	# this on delta 0.18 (see the note above the [delta] section); `git -c` can,
	# because git hands the setting to the pager via GIT_CONFIG_PARAMETERS. The
	# left line-number column comes back for the occasion: the left panel is the
	# old file, and the global "" format would leave it unnumbered.
	sbs = -c delta.side-by-side=true -c "delta.line-numbers-left-format={nm:>4} " diff
