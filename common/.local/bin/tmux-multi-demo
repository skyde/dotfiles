#!/usr/bin/env bash
# tmux-multi-demo — a self-contained playground for tmux-multi.
#
# Fakes a fleet of machines on this one: an `ssh` shim on PATH answers for
# two invented hosts (devbox, buildbox) by routing commands to private tmux
# servers, plus an `offline` host that always times out. Everything lives
# under one directory and one set of demo-* tmux sockets; nothing reads or
# writes the real ~/.tmux.conf, ~/.ssh config, or the default tmux server,
# and the shim refuses hosts it does not know, so it can never stand in for
# a real connection.
#
# Subcommands:
#   start    (re)build the sandbox and boot the fake machines
#   attach   attach to the demo (or: tmux -L demo-local attach)
#   status   what is running, per machine
#   stop     kill every demo tmux server
#   clean    stop + delete the sandbox directory
#
# Keys inside the demo (own config, independent of your dotfiles; the prefix
# matches the dotfiles' M-a so muscle memory works):
#   prefix s / S   cross-machine session picker      prefix N  new session
#   prefix prefix  send one prefix to the inner tmux  prefix d  detach
#
# The status bar shows a red DEMO so the sandbox is never mistaken for a
# real session.

set -euo pipefail

D=${TMUX_MULTI_DEMO_DIR:-$HOME/.cache/tmux-multi-demo}
TMUX_BIN=$(command -v tmux) || { echo 'tmux-multi-demo: tmux is required' >&2; exit 1; }

# tmux-multi normally sits next to this script (repo checkout or stowed
# ~/.local/bin); fall back to PATH.
SELF_DIR=$(cd "$(dirname "$0")" && pwd)
TM=$SELF_DIR/tmux-multi
[ -x "$TM" ] || TM=$(command -v tmux-multi) ||
  { echo 'tmux-multi-demo: cannot find tmux-multi' >&2; exit 1; }

# kitty ships its terminfo inside the app bundle; panes advertising
# xterm-kitty need it findable. Harmless to skip when absent.
KITTY_TI=/Applications/kitty.app/Contents/Resources/kitty/terminfo
[ -d "$KITTY_TI" ] || KITTY_TI=

REMOTES=(devbox buildbox)

build() {
  # The generated tmux binds splice these paths into single-quoted popup
  # commands; spaces or quotes in them would shatter that quoting.
  case "$D$TM" in *[\ \']*)
    echo "tmux-multi-demo: demo dir and tmux-multi paths must not contain spaces or quotes" >&2
    exit 1 ;;
  esac
  rm -rf "$D"
  mkdir -p "$D/bin"

  # Per-host tmux wrappers: on "that machine", `tmux` means that machine's
  # own private server. A tmux machine is really just a socket.
  local h
  for h in "${REMOTES[@]}"; do
    mkdir -p "$D/remote/$h"
    printf '#!/usr/bin/env bash\nexec %s -L demo-%s "$@"\n' \
      "$TMUX_BIN" "$h" >"$D/remote/$h/tmux"
    chmod +x "$D/remote/$h/tmux"
  done

  # The ssh shim. Parses like real ssh (queries: `ssh -n -o ... host -- cmd`,
  # attaches: `ssh -t host -- cmd`), then runs the command locally with the
  # environment a real remote shell would have.
  {
    printf '#!/usr/bin/env bash\nDEMO=%q\nKITTY_TI=%q\n' "$D" "$KITTY_TI"
    cat <<'SHIM'
host= cmd= gflag=
args=("$@"); i=0
while [ $i -lt ${#args[@]} ]; do
  a=${args[$i]}
  case $a in
    -o) i=$((i+1)) ;;              # -o eats its argument
    -G) gflag=1 ;;                 # doctor probes ControlMaster via ssh -G
    -t|-n|--) ;;
    *) if [ -z "$host" ]; then host=$a; else cmd="$cmd $a"; fi ;;
  esac
  i=$((i+1))
done
[ -n "$gflag" ] && { echo 'controlmaster auto'; exit 0; }

case $host in
  devbox|buildbox) ;;
  offline)
    sleep 0.3
    echo "ssh: connect to host $host port 22: Operation timed out" >&2
    exit 255 ;;
  *)
    echo "fake-ssh: refusing unknown host '$host' (demo knows devbox, buildbox, offline)" >&2
    exit 255 ;;
esac

# What a real ssh session looks like from the inside: no outer TMUX, the
# SSH_* markers set, and the fake machine's tmux first on PATH.
unset TMUX TMUX_PANE
export SSH_CONNECTION='10.0.0.5 52341 10.0.0.9 22' SSH_TTY=/dev/ttys999
[ -n "$KITTY_TI" ] && export TERMINFO="$KITTY_TI"
export PATH="$DEMO/remote/$host:$PATH"
exec bash -c "$cmd"
SHIM
  } >"$D/bin/ssh"
  chmod +x "$D/bin/ssh"

  printf '# fake machines served by %s/bin/ssh\ndevbox\nbuildbox\noffline\n' \
    "$D" >"$D/hosts"

  # Config for the fake remotes' servers. Deliberately minimal and
  # self-contained; status-left is set per machine at start.
  cat >"$D/remote.conf" <<'CONF'
set -g default-terminal xterm-256color
# Real remotes share the dotfiles, so they answer to the same prefix and
# custom binds (flat keys forward these from the outer tmux).
set -g prefix M-a
bind-key h select-pane -L
bind-key j select-pane -D
bind-key k select-pane -U
bind-key l select-pane -R
bind-key C new-window -a
set -g base-index 1
set -g mouse on
set -g status-position top
set -g status-style 'bg=#1a1b26,fg=#565f89'
set -g status-left-length 30
# No hostname/clock on the right: the real hostname would break the illusion.
set -g status-right ''
CONF

  # Config for the local demo server: everything tmux-multi needs, nothing
  # from the real dotfiles. PATH and the hosts file are pinned inline so the
  # shim wins no matter what login shells do to PATH. The popup commands are
  # single-quoted in the conf: tmux expands \$VARS in double-quoted config
  # strings at load time, which would bake the *builder's* PATH into the
  # binding (and PATHs with spaces then shatter the popup's sh -c line).
  local popup="PATH=$D/bin:\$PATH TMUX_MULTI_HOSTS_FILE=$D/hosts $TM"
  cat >"$D/demo.conf" <<CONF
set -g default-terminal xterm-256color
set -g prefix M-a
set -g base-index 1
set -g renumber-windows on
set -g mouse on
set -g status-position top
set -g status-style 'bg=#1a1b26,fg=#565f89'
set -g status-left "#[bg=#1a1b26,fg=#ff9e64] #S  "
set -g status-left-length 30
set -g status-right "#[fg=#f7768e,bold]DEMO "

bind-key s display-popup -E -w 100% -h 100% '$popup pick'
bind-key S display-popup -E -w 100% -h 100% '$popup pick'
bind-key N display-popup -E -w 100% -h 100% '$popup new'

# Flat view (mirrors the dotfiles): hide this bar while the current window
# holds a remote session, so only that machine's bar shows.
set-hook -g session-window-changed "set -F status '#{?#{!=:#{@tmux_multi_target},},off,on}'"

# Flat keys (mirrors the dotfiles): window/pane-level commands forward to
# the machine you are looking at; session-level keys (s/S/N, d) stay local.
bind-key n if-shell -F '#{!=:#{@tmux_multi_target},}' { send-keys M-a n } { next-window }
bind-key p if-shell -F '#{!=:#{@tmux_multi_target},}' { send-keys M-a p } { previous-window }
bind-key c if-shell -F '#{!=:#{@tmux_multi_target},}' { send-keys M-a c } { new-window }
bind-key x if-shell -F '#{!=:#{@tmux_multi_target},}' { send-keys M-a x } { confirm-before -p "kill-pane #P? (y/n)" kill-pane }
bind-key z if-shell -F '#{!=:#{@tmux_multi_target},}' { send-keys M-a z } { resize-pane -Z }
bind-key h if-shell -F '#{!=:#{@tmux_multi_target},}' { send-keys M-a h } { select-pane -L }
bind-key j if-shell -F '#{!=:#{@tmux_multi_target},}' { send-keys M-a j } { select-pane -D }
bind-key k if-shell -F '#{!=:#{@tmux_multi_target},}' { send-keys M-a k } { select-pane -U }
bind-key l if-shell -F '#{!=:#{@tmux_multi_target},}' { send-keys M-a l } { select-pane -R }
bind-key 1 if-shell -F '#{!=:#{@tmux_multi_target},}' { send-keys M-a 1 } { select-window -t :=1 }
bind-key 2 if-shell -F '#{!=:#{@tmux_multi_target},}' { send-keys M-a 2 } { select-window -t :=2 }
bind-key 3 if-shell -F '#{!=:#{@tmux_multi_target},}' { send-keys M-a 3 } { select-window -t :=3 }

# Double-tap the prefix to send one prefix to the inner tmux (mirrors the
# dotfiles; there is no sustained handoff mode on purpose).
bind-key M-a send-prefix
CONF
}

# Run tmux against one demo server, TMUX unset so nesting checks stay quiet.
t() { # t <socket-suffix> <tmux args...>
  local sock=$1; shift
  env -u TMUX "$TMUX_BIN" -L "demo-$sock" "$@"
}

seed() { # seed <socket-suffix> <session> <text...>
  local sock=$1 sess=$2; shift 2
  t "$sock" send-keys -t "=$sess:" "clear; printf '%s\n' \"$*\"" C-m
}

cmd_start() {
  cmd_stop >/dev/null 2>&1 || true
  build

  local h s
  for h in "${REMOTES[@]}"; do
    t "$h" -f "$D/remote.conf" new-session -d -s placeholder -x 200 -y 50
    t "$h" set -g status-left "#[bg=#1a1b26,fg=#9ece6a,bold] $h #[fg=#ff9e64,nobold]#S  "
    [ -n "$KITTY_TI" ] && t "$h" set-environment -g TERMINFO "$KITTY_TI"
  done
  for s in api web 'db migrate'; do t devbox new-session -d -s "$s" -x 200 -y 50; done
  for s in ci release; do t buildbox new-session -d -s "$s" -x 200 -y 50; done
  t devbox kill-session -t =placeholder
  t buildbox kill-session -t =placeholder
  seed devbox web 'server listening on :8080' 'GET /health 200'
  seed devbox 'db migrate' 'applying 0042_add_index... done'
  seed buildbox ci 'build #1287 running: 412/509 tests'

  t local -f "$D/demo.conf" new-session -d -s laptop -x 200 -y 50
  t local new-session -d -s notes
  [ -n "$KITTY_TI" ] && t local set-environment -g TERMINFO "$KITTY_TI"
  seed local notes 'shopping list: milk, coffee'

  echo 'demo up. attach with:'
  echo '  tmux-multi-demo attach'
}

cmd_attach() {
  t local ls >/dev/null 2>&1 || { echo 'demo is not running — start it first' >&2; exit 1; }
  exec env -u TMUX "$TMUX_BIN" -L demo-local attach -t laptop
}

cmd_status() {
  local sock
  for sock in local "${REMOTES[@]}"; do
    printf '%-10s ' "demo-$sock"
    t "$sock" list-sessions -F '#{session_name}' 2>/dev/null | tr '\n' ' ' ||
      printf 'not running'
    echo
  done
}

cmd_stop() {
  local sock
  for sock in local "${REMOTES[@]}"; do
    t "$sock" kill-server 2>/dev/null && echo "stopped demo-$sock" || true
  done
  echo 'demo down (the real tmux server is untouched)'
}

cmd_clean() {
  cmd_stop
  rm -rf "$D"
  echo "removed $D"
}

case ${1:-} in
  start) cmd_start ;;
  attach) cmd_attach ;;
  status) cmd_status ;;
  stop) cmd_stop ;;
  clean) cmd_clean ;;
  -h | --help | help | '') sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "tmux-multi-demo: unknown command: $1 (try --help)" >&2; exit 1 ;;
esac
