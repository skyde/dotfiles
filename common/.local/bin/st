#!/usr/bin/env bash
# st — search a tree, picking the fastest backend it has.
#
#   st [--code] [PATH]
#
# Zoekt when PATH has an index, ripgrep otherwise. Both halves take the same
# arguments, so everything is forwarded untouched.
set -euo pipefail

# Probe the tree actually being searched. Testing a bare `.zoekt` only consulted
# the current directory, so `st ~/some/indexed/tree` fell through to ripgrep.
args=("$@")
target="$PWD"
for arg in "${args[@]}"; do
  case "$arg" in
  --code) ;;
  *) target="$arg" ;;
  esac
done

if [[ -f "$target" ]]; then
  target="$(dirname "$target")"
fi

if [[ -d "$target/.zoekt" ]]; then
  exec st-zoekt "$@"
else
  exec st-rg "$@"
fi
