#!/usr/bin/env bash
# tmux-multi — one tmux "session space" across several computers.
#
# Each machine keeps its own tmux server (so sessions survive disconnects);
# this tool makes them feel like a single pool: a picker that lists every
# session on every configured host, opens remote sessions in a local window
# over ssh, and creates or kills sessions on whichever machine you choose.
#
# Hosts are read from ~/.config/tmux-multi/hosts (one ssh destination per
# line; see common/.config/tmux-multi/hosts.example). List *all* of your
# machines in it — each machine skips its own name, so the same dotfiles
# work as the hub from any of them.
#
# Subcommands:
#   pick                 fzf picker over every session on every host (default)
#   new                  pick a host, then create/pick a session on it
#   ls                   print "host<TAB>session<TAB>windows<TAB>attached"
#   open HOST SESSION    open (attach/create) a session on HOST
#   kill HOST SESSION    kill a session on HOST (and its local ssh window)
#   preview HOST SESSION render a session (all windows; remotes cached ~10s)
#   shell-attach HOST S  internal: the ssh loop that runs inside a window
#   doctor               check ssh + tmux on every configured host
#
# Full docs: docs/tmux-multi.md in the dotfiles repo.

set -euo pipefail

HOSTS_FILE="${TMUX_MULTI_HOSTS_FILE:-$HOME/.config/tmux-multi/hosts}"
TAB=$'\t'

# Fast, never-prompting ssh for background queries (listing sessions, kill,
# previews): -n keeps ssh away from stdin (it would eat the host list in
# read loops). Interactive attaches use plain `ssh -t` so auth prompts still
# work there.
QUERY_SSH=(ssh -n -o BatchMode=yes -o ConnectTimeout=3)

# Remote tmux may not be on the non-interactive PATH (Homebrew on macOS,
# ~/.local/bin installs). Single quotes on purpose: PATH/HOME must expand on
# the remote machine, not here.
# shellcheck disable=SC2016
REMOTE_PATH='PATH="$PATH:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin"'

# Absolute path to this script, for tmux window commands and fzf binds where
# PATH may differ from the invoking shell's.
SELF=$(command -v -- "$0" || printf '%s' "$0")
case $SELF in
  /*) ;;
  *) SELF="$(cd "$(dirname "$SELF")" && pwd)/$(basename "$SELF")" ;;
esac

die() {
  printf 'tmux-multi: %s\n' "$*" >&2
  exit 1
}

# Quote a string for a remote POSIX shell.
shq() {
  local s=$1
  s=${s//\'/\'\\\'\'} # ' -> '\''
  printf "'%s'" "$s"
}

local_name() {
  hostname -s 2>/dev/null || hostname
}

# Is this host entry the machine we are on?
is_self() {
  local h=$1 n
  # shellcheck disable=SC2086  # TMUX_MULTI_SELF may hold several names
  for n in "$(local_name)" "$(hostname 2>/dev/null)" local ${TMUX_MULTI_SELF:-}; do
    [ -n "$n" ] && [ "$h" = "$n" ] && return 0
  done
  return 1
}

# Configured hosts, comments stripped, this machine excluded.
remote_hosts() {
  [ -f "$HOSTS_FILE" ] || return 0
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%%#*}
    # trim surrounding whitespace
    line=${line#"${line%%[![:space:]]*}"}
    line=${line%"${line##*[![:space:]]}"}
    [ -z "$line" ] && continue
    is_self "$line" && continue
    printf '%s\n' "$line"
  done <"$HOSTS_FILE"
}

# ---- session listing ------------------------------------------------------

# tmux replaces control characters (tabs included) with '_' when expanding
# formats, so tmux emits space-separated fields with the session name LAST
# (names may contain spaces; the other fields never do) and to_tsv rebuilds
# real tab-separated lines locally:
#   activity<TAB>host<TAB>session<TAB>Nw<TAB>attached|-
# The activity column is only used to sort; ls/pick strip it.
SESS_FMT='#{session_activity} #{session_windows}w #{?session_attached,attached,-} #{session_name}'

to_tsv() {
  awk -v host="$1" '
    NF >= 4 {
      name = substr($0, length($1) + length($2) + length($3) + 4)
      printf "%s\t%s\t%s\t%s\t%s\n", $1, host, name, $2, $3
    }'
}

list_local() {
  tmux list-sessions -F "$SESS_FMT" 2>/dev/null | to_tsv "$(local_name)" || true
}

list_remote() {
  local host=$1
  "${QUERY_SSH[@]}" "$host" -- \
    "$REMOTE_PATH tmux list-sessions -F $(shq "$SESS_FMT") 2>/dev/null" \
    2>/dev/null | to_tsv "$host" || true
}

list_all() {
  local tmp host i=0
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/tmux-multi.XXXXXX")
  # shellcheck disable=SC2064  # expand $tmp now, not at trap time
  trap "rm -rf '$tmp'" EXIT
  list_local >"$tmp/l" &
  while IFS= read -r host; do
    [ -z "$host" ] && continue
    list_remote "$host" >"$tmp/r$i" &
    i=$((i + 1))
  done < <(remote_hosts)
  wait
  cat "$tmp"/* 2>/dev/null | sort -t "$TAB" -rn -k1,1 | cut -f2-
}

cmd_ls() {
  list_all
}

# ---- open / attach --------------------------------------------------------

# Remote command that attaches (creating if needed) a session, preferring the
# dotfiles' tmux-session helper so new sessions get the default layout.
remote_attach_cmd() {
  local q
  q=$(shq "$1")
  printf '%s' "$REMOTE_PATH; if command -v tmux-session >/dev/null 2>&1; then exec tmux-session $q; else exec tmux new-session -A -s $q; fi"
}

# The command that runs inside a local tmux window holding a remote session.
# Marks its window so `open` can find it again, then loops ssh so a dropped
# connection offers to reconnect instead of silently closing the window.
cmd_shell_attach() {
  local host=${1:?host required} sess=${2:?session required} rc ans
  if [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ]; then
    tmux set-option -w -t "$TMUX_PANE" automatic-rename off 2>/dev/null || true
    tmux set-option -w -t "$TMUX_PANE" @tmux_multi_target "${host}:${sess}" 2>/dev/null || true
    tmux rename-window -t "$TMUX_PANE" "${sess}@${host}" 2>/dev/null || true
  fi
  while :; do
    rc=0
    ssh -t "$host" -- "$(remote_attach_cmd "$sess")" || rc=$?
    # Clean exit means the user detached or the remote session ended on
    # purpose; anything else is a lost connection.
    [ "$rc" -eq 0 ] && exit 0
    printf '\n[tmux-multi] connection to %s lost (ssh exit %d)\n' "$host" "$rc"
    printf 'Press Enter to reconnect, q to close this window: '
    IFS= read -r ans || exit 0
    case $ans in q | Q) exit 0 ;; esac
  done
}

# Find an existing local window already holding host:session.
# Prints "session_id window_id" or nothing. Space-separated for the same
# reason as SESS_FMT: the tag (which may contain spaces) comes last.
find_window() {
  local target="$1:$2"
  tmux list-windows -a -F '#{session_id} #{window_id} #{@tmux_multi_target}' 2>/dev/null |
    awk -v t="$target" '
      NF >= 3 {
        tag = substr($0, length($1) + length($2) + 3)
        if (tag == t) { print $1, $2; exit }
      }'
}

cmd_open() {
  local host=${1:?host required} sess=${2:?session required}
  if is_self "$host"; then
    # Local session: create with the default layout if we have the helper.
    if ! tmux has-session -t "=$sess" 2>/dev/null; then
      if command -v tmux-session >/dev/null 2>&1; then
        tmux-session "$sess" '' --no-attach
      else
        tmux new-session -d -s "$sess"
      fi
    fi
    if [ -n "${TMUX:-}" ]; then
      exec tmux switch-client -t "=$sess"
    else
      exec tmux attach-session -t "=$sess"
    fi
  fi

  if [ -n "${TMUX:-}" ]; then
    local found sid wid
    found=$(find_window "$host" "$sess")
    if [ -n "$found" ]; then
      sid=${found%% *}
      wid=${found##* }
      tmux select-window -t "$wid"
      exec tmux switch-client -t "$sid"
    fi
    # Tag the window here, not just in shell-attach: the flat-view hook in
    # .tmux.conf reads @tmux_multi_target when the current window changes,
    # and it fires before the code inside the new window gets to run. Same
    # reason for setting the initial status state explicitly.
    wid=$(tmux new-window -P -F '#{window_id}' -- "$SELF" shell-attach "$host" "$sess")
    tmux set-option -w -t "$wid" @tmux_multi_target "${host}:${sess}"
    exec tmux set-option -t "$wid" status off
  fi
  # Outside tmux: attach in this terminal.
  exec "$SELF" shell-attach "$host" "$sess"
}

# ---- kill -----------------------------------------------------------------

cmd_kill() {
  local host=${1:?host required} sess=${2:?session required}
  if is_self "$host"; then
    if [ -n "${TMUX:-}" ] && [ "$(tmux display-message -p '#S')" = "$sess" ]; then
      tmux display-message "tmux-multi: not killing the session you are in"
      return 1
    fi
    tmux kill-session -t "=$sess"
  else
    "${QUERY_SSH[@]}" "$host" -- \
      "$REMOTE_PATH tmux kill-session -t $(shq "=$sess") 2>/dev/null" \
      2>/dev/null ||
      die "could not kill $sess on $host"
    # Close the local window that was attached to it, if any. The ssh in
    # that window usually exits (and closes it) on its own, so tolerate the
    # window already being gone.
    if [ -n "${TMUX:-}" ]; then
      local found
      found=$(find_window "$host" "$sess")
      if [ -n "$found" ]; then
        tmux kill-window -t "${found##* }" 2>/dev/null || true
      fi
    fi
  fi
}

# ---- preview (fzf preview pane) -------------------------------------------

# The preview shows every window of the session: a header per window plus a
# live, still-coloured capture of that window's pane, so you recognise a
# session by what is on its screens rather than by window names alone.

# Run a snippet against HOST's tmux — locally, or over ssh for a remote.
on_host() {
  local host=$1 snippet=$2
  if is_self "$host"; then
    eval "$snippet" 2>/dev/null || true
  else
    "${QUERY_SSH[@]}" "$host" -- "$REMOTE_PATH $snippet" 2>/dev/null || true
  fi
}

# One command string that walks a session's windows and emits, per window, a
# \001-marker line (index, active flag, name) followed by a coloured capture
# of its pane. Shared verbatim between the local and ssh paths, so remotes
# cost a single round trip.
win_dump_snippet() {
  local q
  q=$(shq "=$1")
  printf '%s' "tmux list-windows -t $q -F '#{window_index} #{window_active} #{window_name}' 2>/dev/null | while IFS=' ' read -r i a n; do printf '\\001%s\\001%s\\001%s\\n' \"\$i\" \"\$a\" \"\$n\"; tmux capture-pane -ep -t $q:\"\$i\" 2>/dev/null; done"
}

# Turn the marker stream into the rendered preview: window headers (active
# reversed, inactive dimmed), per-window trailing blank lines dropped, and —
# when fzf tells us the preview height — each window capped to its last lines
# so every window stays visible without scrolling.
format_preview() {
  awk -v rows="${FZF_PREVIEW_LINES:-0}" '
    /^\x01/ {
      n++
      split($0, p, "\x01")
      head[n] = p[2] ":" p[4]
      active[n] = (p[3] == "1")
      pending[n] = ""; buf = ""
      next
    }
    # Buffer pane lines; blank runs only survive if content follows, which
    # drops each window'\''s unused bottom rows.
    n { buf = buf $0 "\n"; if (NF) { pending[n] = pending[n] buf; buf = "" } }
    END {
      if (!n) exit
      # Share the preview height between windows (header lines included) so
      # every window is visible without scrolling; keep at least a few lines
      # each, and show the LAST lines — that is where the action is.
      cap = 0
      if (rows > n) { cap = int((rows - n) / n); if (cap < 3) cap = 3 }
      for (i = 1; i <= n; i++) {
        keep = split(pending[i], lines, "\n") - 1
        first = (cap > 0 && keep > cap) ? keep - cap + 1 : 1
        if (active[i])
          printf "\033[7;1m %s \033[0m\n", head[i]
        else
          printf "\033[2m %s \033[0m\n", head[i]
        for (j = first; j <= keep; j++) print lines[j]
      }
    }'
}

# Remote previews are cached briefly so hovering around the picker does not
# pay an ssh round trip per keystroke. Local previews are cheap: always live.
PREVIEW_TTL=10

preview_cache_file() {
  local dir
  dir="${TMPDIR:-/tmp}/tmux-multi-preview-$(id -u)"
  mkdir -p "$dir" && chmod 700 "$dir"
  printf '%s/%s' "$dir" "$(printf '%s' "$1" | cksum | tr -cd '0-9')"
}

cmd_preview() {
  local host=${1:?host required} sess=${2:?session required} cache='' now mt out
  if ! is_self "$host"; then
    cache=$(preview_cache_file "$host:$sess")
    if [ -f "$cache" ]; then
      now=$(date +%s)
      mt=$(stat -f %m "$cache" 2>/dev/null || stat -c %Y "$cache" 2>/dev/null || echo 0)
      if [ $((now - mt)) -lt "$PREVIEW_TTL" ]; then
        cat "$cache"
        return 0
      fi
    fi
  fi
  out=$(on_host "$host" "$(win_dump_snippet "$sess")" | format_preview)
  if [ -n "$cache" ]; then
    printf '%s\n' "$out" >"$cache.tmp" 2>/dev/null && mv "$cache.tmp" "$cache" 2>/dev/null || true
  fi
  printf '%s\n' "$out"
}

# ---- interactive pickers --------------------------------------------------

need_fzf() {
  command -v fzf >/dev/null 2>&1 && return 0
  if [ -n "${TMUX:-}" ]; then
    tmux display-message 'tmux-multi: fzf is required'
  fi
  die 'fzf is required'
}

# The picker's display rows: session name first (it is what you scan for),
# padded columns, Tokyo Night colours. Underlying fields stay TAB-separated
# so fzf placeholders keep working; --ansi strips the colours for matching.
cmd_rows() {
  "$SELF" ls | awk -F "$TAB" -v self="$(local_name)" '
    {
      hc = ($1 == self) ? "\033[38;2;122;162;247m" : "\033[1;38;2;158;206;106m"
      ac = ($4 == "attached") ? "\033[38;2;224;175;104mattached" : "\033[38;2;86;95;137m-"
      printf "\033[1;38;2;255;158;100m%-24s\033[0m\t%s%-12s\033[0m\t\033[38;2;86;95;137m%3s\033[0m\t%s\033[0m\n",
        $2, hc, $1, $3, ac
    }'
}

cmd_pick() {
  need_fzf
  local out key sel host sess
  # Vim-style: j/k move, / searches (esc leaves search), q quits. Session
  # column first, preview across the bottom showing every window.
  out=$("$SELF" rows | fzf \
    --delimiter="$TAB" \
    --prompt='/ ' \
    --header='j/k move  / search  enter open  ctrl-n new  ctrl-x kill  ctrl-r refresh  q quit' \
    --expect=ctrl-n \
    --print-query \
    --ansi \
    --layout=reverse \
    --no-input \
    --bind='j:down,k:up,q:abort,/:show-input+unbind(j,k,q,/)' \
    --bind='esc:clear-query+hide-input+rebind(j,k,q,/)' \
    --preview="$SELF preview {2} {1}" \
    --preview-window='down:65%:nowrap' \
    --bind="ctrl-x:execute-silent($SELF kill {2} {1})+reload($SELF rows)" \
    --bind="ctrl-r:reload($SELF rows)") || true
  key=$(printf '%s\n' "$out" | sed -n 2p)
  sel=$(printf '%s\n' "$out" | sed -n 3p)
  if [ "$key" = ctrl-n ]; then
    exec "$SELF" new
  fi
  [ -z "$sel" ] && exit 0
  # Fields carry display padding; strip it before using them as tmux targets.
  sess=$(printf '%s\n' "$sel" | cut -f1 | sed 's/[[:space:]]*$//')
  host=$(printf '%s\n' "$sel" | cut -f2 | sed 's/[[:space:]]*$//')
  exec "$SELF" open "$host" "$sess"
}

cmd_new() {
  need_fzf
  local host out query sel name
  host=$( (
    printf '%s\t(this machine)\n' "$(local_name)"
    remote_hosts
  ) | fzf \
    --delimiter="$TAB" \
    --prompt='host> ' \
    --header='where should the session live?' |
    cut -f1) || true
  [ -z "$host" ] && exit 0
  out=$("$SELF" ls | awk -F "$TAB" -v h="$host" '$1 == h { print $2 }' | fzf \
    --prompt="session on ${host}> " \
    --header='pick an existing session or type a new name' \
    --print-query) || true
  query=$(printf '%s\n' "$out" | sed -n 1p)
  sel=$(printf '%s\n' "$out" | sed -n 2p)
  name=${sel:-$query}
  [ -z "$name" ] && name=main
  exec "$SELF" open "$host" "$name"
}

# ---- doctor ---------------------------------------------------------------

cmd_doctor() {
  local host ver count ok=0 fail=0
  printf 'hosts file: %s\n' "$HOSTS_FILE"
  [ -f "$HOSTS_FILE" ] || printf '  (missing — copy hosts.example there)\n'
  printf 'this machine: %s\n\n' "$(local_name)"
  while IFS= read -r host; do
    [ -z "$host" ] && continue
    printf '%s: ' "$host"
    if ver=$("${QUERY_SSH[@]}" "$host" -- "$REMOTE_PATH tmux -V" 2>/dev/null); then
      # `|| true` inside the substitution: a host with tmux installed but no
      # server running exits non-zero, which must read as "0 sessions", not
      # abort the whole report under set -e/pipefail.
      count=$({ "${QUERY_SSH[@]}" "$host" -- \
        "$REMOTE_PATH tmux list-sessions -F x 2>/dev/null" 2>/dev/null || true; } | wc -l | tr -d ' ')
      printf 'ok (%s, %s sessions)\n' "$ver" "$count"
      ok=$((ok + 1))
    else
      printf 'FAILED (ssh unreachable, key auth not set up, or tmux missing)\n'
      fail=$((fail + 1))
    fi
    if ssh -n -G "$host" 2>/dev/null | grep -qi '^controlmaster false$'; then
      printf '  hint: enable ssh ControlMaster for a fast picker (docs/tmux-multi.md)\n'
    fi
  done < <(remote_hosts)
  printf '\n%d ok, %d failed\n' "$ok" "$fail"
  [ "$fail" -eq 0 ]
}

# ---- dispatch -------------------------------------------------------------

cmd=${1:-pick}
shift 2>/dev/null || true
case $cmd in
  pick) cmd_pick "$@" ;;
  new) cmd_new "$@" ;;
  ls) cmd_ls "$@" ;;
  open) cmd_open "$@" ;;
  kill) cmd_kill "$@" ;;
  preview | windows) cmd_preview "$@" ;;
  rows) cmd_rows ;;
  shell-attach) cmd_shell_attach "$@" ;;
  doctor) cmd_doctor "$@" ;;
  hosts) remote_hosts ;;
  -h | --help | help) sed -n '2,24p' "$SELF" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command: $cmd (try --help)" ;;
esac
