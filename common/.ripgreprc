
# Global ripgrep config mirroring common search excludes.
# IMPORTANT: In .ripgreprc every line is a single argv; there's no shell quoting.
# Use --flag=value or put the value on the next line. No quotes. No spaces around '='.

# General config
--hidden
--smart-case

# --- Colours (Tokyo Night night — palette reference: docs/tokyonight.md) ---
# rg takes decimal RGB triples, not hex, so each line carries the hex it means.
#
# A match is an inverted yellow block rather than recoloured text: the same
# gesture as fzf's hl/hl+ and delta's grep-match-word-style, and for the same
# reason. rg's output is routinely piped into something that has already
# coloured the line — st-rg's fzf picker, delta --grep, bat — where swapping
# only the foreground drops a colour into a line that may already be wearing
# it. Foreground and background inverted cannot be lost that way.
#
# Remember the rule at the top of this file: a line is one argv, so the hex a
# triple stands for has to sit on its own comment line — trailing it after the
# value makes the comment part of the colour and rg refuses to start.
#
# bg #1a1b26 on yellow #e0af68
--colors=match:fg:26,27,38
--colors=match:bg:224,175,104
--colors=match:style:bold
# Path and line number mirror delta's grep-file-style / grep-line-number-style
# so `rg foo` and `git grep foo` (which pages through delta) read alike.
# blue #7aa2f7
--colors=path:fg:122,162,247
# dark3 #545c7e
--colors=line:fg:84,92,126
--colors=column:fg:84,92,126

# Exclude compile_commands.json
--glob=!/compile_commands.json

# --- VCS ---
--glob=!.git/
--glob=!.svn/
--glob=!.hg/

# --- IDE / Editor / OS junk ---
--glob=!.idea/
--glob=!.DS_Store
--glob=!.vs/
--glob=!*.swp
--glob=!*.swo
--glob=!*.bak

# --- General build / cache / temp ---
--glob=!out/
--glob=!obj/
--glob=!dist/
--glob=!build/
--glob=!tmp/
--glob=!temp/
--glob=!cache/
--glob=!.cache/
--glob=!logs/
--glob=!*.log
--glob=!*.tmp
--glob=!*.dSYM/    # macOS debug bundles are directories

# --- Node / Frontend ---
--glob=!node_modules/
--glob=!bower_components/
--glob=!jspm_packages/
--glob=!coverage/
--glob=!.next/
--glob=!.nuxt/
--glob=!.svelte-kit/
--glob=!.turbo/
--glob=!.vercel/
--glob=!.cache-loader/

# --- Python ---
--glob=!__pycache__/
--glob=!.mypy_cache/
--glob=!.pytest_cache/
--glob=!.tox/
--glob=!.eggs/
--glob=!*.egg-info
--glob=!*.egg-info/
--glob=!.ipynb_checkpoints/
--glob=!.venv/
--glob=!env/

# --- Java / JVM ---
--glob=!.gradle/
--glob=!.mvn/
--glob=!target/
--glob=!build/classes/
--glob=!build/generated/
--glob=!*.class

# --- PHP / Composer ---
--glob=!vendor/

# --- C / C++ ---
--glob=!CMakeFiles/
--glob=!CMakeCache.txt
--glob=!Default/
--glob=!Debug/
--glob=!Release/
--glob=!*.o
--glob=!*.obj
--glob=!*.exe
--glob=!*.pdb
--glob=!*.ilk

# --- Go ---
--glob=!pkg/
--glob=!bin/

# --- Infra / DevOps ---
--glob=!.terraform/
--glob=!.ansible/
--glob=!.chef/
--glob=!.serverless/

# --- Static Site Generators ---
--glob=!.jekyll-cache/
--glob=!_site/
--glob=!.docusaurus/

# --- Generated / build system artifacts ---
--glob=!gen/
--glob=!*.ninja
--glob=!*.stamp

# --- File types excluded from search ---
--glob=!*.svg
--glob=!*.key
